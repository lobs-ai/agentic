{
  "name": "@agentic/tools",
  "version": "0.1.0",
  "description": "Standalone tool implementations for AI agents — read, write, edit, exec, grep, glob, web search, and more",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "ai",
    "agent",
    "tools",
    "llm",
    "exec",
    "read",
    "write",
    "edit",
    "grep",
    "glob",
    "web-search",
    "file-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}

{
  "name": "agentic",
  "version": "0.1.0",
  "description": "Zero-config agent runtime — one install, all providers, tool auto-discovery, pluggable context engine",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentic/llm": "^0.1.0",
    "@agentic/tools": "^0.1.0",
    "@agentic/runner": "^0.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "typescript": "^5.8.3"
  }
}
